generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         Int                         @id @default(autoincrement())
  email                      String                      @unique
  password                   String
  fullName                   String                      @map("full_name")
  username                   String                      @unique
  role                       String
  permissions                String?
  location                   String?
  zone                       String?
  isActive                   Boolean?                    @default(true) @map("is_active")
  createdAt                  DateTime?                   @default(now()) @map("created_at")
  updatedAt                  DateTime?                   @default(now()) @map("updated_at")
  phoneNumber                String?                     @map("phone_number")
  address                    String?
  zipCode                    String?                     @map("zip_code")
  avatar                     String?
  accountNumber              String?                     @unique @map("account_number") @db.VarChar
  linkedAgents               Json?                       @default("[]") @map("linked_agents")
  agentSuspensionsApproved   AgentSuspension[]           @relation("approved_by")
  agentSuspensionsSuspended  AgentSuspension[]           @relation("suspended_by")
  commissionUserAssignments  CommissionUserAssignment[]
  regionalManagerAssignments RegionalManagerAssignment[]
  userLoginSessions          UserLoginSession[]
  userNotifications          UserNotification[]

  @@map("users")
}

model Agent {
  id                          Int                         @id @default(autoincrement())
  accountNumber               String                      @unique @map("account_number")
  name                        String
  type                        String
  branchCode                  String                      @map("branch_code")
  branchName                  String                      @map("branch_name")
  parentAgentId               Int?                        @map("parent_agent_id")
  isActive                    Int?                        @default(1) @map("is_active")
  commissionEligible          Int?                        @default(1) @map("commission_eligible")
  totalTransactionAmount      Float?                      @default(0) @map("total_transaction_amount")
  transactionCount            Int?                        @default(0) @map("transaction_count")
  commissionAmount            Float?                      @default(0) @map("commission_amount")
  payband                     Float?                      @default(1.0)
  createdAt                   DateTime?                   @default(now()) @map("created_at")
  updatedAt                   DateTime?                   @default(now()) @map("updated_at")
  username                    String?
  email                       String?
  phone                       String?
  contact                     String?
  role                        String?
  region                      String?
  zone                        String?
  agentAssignmentsAsFranchise AgentAssignment[]           @relation("Franchise")
  agentAssignmentsAsLocal     AgentAssignment[]           @relation("LocalAgent")
  agentAssignmentsAsSuper     AgentAssignment[]           @relation("SuperAgent")
  agentSuspensions            AgentSuspension[]
  parentAgent                 Agent?                      @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  childAgents                 Agent[]                     @relation("AgentHierarchy")
  commissions                 Commission[]
  regionalManagerAssignments  RegionalManagerAssignment[]
  transactions                Transaction[]

  @@map("agents")
}

model Transaction {
  id                 Int       @id @default(autoincrement())
  transactionId      String    @unique @map("transaction_id")
  agentId            Int?      @map("agent_id")
  agentName          String    @map("agent_name")
  customerName       String    @map("customer_name")
  customerPhone      String?   @map("customer_phone")
  customerAccount    String?   @map("customer_account")
  type               String
  amount             Float
  fee                Float?    @default(0)
  netAmount          Float?    @map("net_amount")
  commissionAmount   Float?    @default(0) @map("commission_amount")
  commissionEligible Int?      @default(1) @map("commission_eligible")
  status             String?   @default("pending")
  location           String?
  zone               String?
  channel            String?
  narration          String?
  reference          String?
  initiatedBy        String?   @default("customer") @map("initiated_by")
  timestamp          DateTime? @default(now())
  createdAt          DateTime? @default(now()) @map("created_at")
  agent              Agent?    @relation(fields: [agentId], references: [id])

  @@map("transactions")
}

model CommissionConfig {
  id                        Int                        @id @default(autoincrement())
  title                     String
  code                      String                     @unique
  description               String?
  type                      String                     @default("percentage")
  value                     Float
  agentType                 String                     @default("all") @map("agent_type")
  status                    String                     @default("active")
  minTransactionAmount      Float?                     @default(100000) @map("min_transaction_amount")
  commissionRate            Float?                     @default(0.05) @map("commission_rate")
  superAgentCommissionRate  Float?                     @default(0.2) @map("super_agent_commission_rate")
  superAgentFixedRate       Float?                     @default(0.3) @map("super_agent_fixed_rate")
  superAgentVariableRate    Float?                     @default(0.7) @map("super_agent_variable_rate")
  franchiseMultiplier       Float?                     @default(4.5) @map("franchise_multiplier")
  kpiWeights                String?                    @map("kpi_weights")
  isActive                  Int?                       @default(1) @map("is_active")
  createdAt                 DateTime?                  @default(now()) @map("created_at")
  updatedAt                 DateTime?                  @default(now()) @map("updated_at")
  paybandRates              String?                    @map("payband_rates")
  franchiseBaseRate         Float?                     @default(0.0005) @map("franchise_base_rate")
  startDate                 DateTime?                  @map("start_date")
  endDate                   DateTime?                  @map("end_date")
  commissionUserAssignments CommissionUserAssignment[]

  @@map("commission_configs")
}

model Commission {
  id                      Int       @id @default(autoincrement())
  agent_id                Int
  agent_name              String
  agent_type              String
  period                  String
  transaction_count       Int       @default(0)
  total_amount            Float     @default(0)
  eligible_amount         Float     @default(0)
  commission_rate         Float     @default(0)
  commission_amount       Float     @default(0)
  payband                 Float     @default(0)
  calculation_details     String?
  status                  String?   @default("calculated")
  created_at              DateTime? @default(now())
  updated_at              DateTime? @default(now())
  actual_turnover         Float?
  capital_advanced        Float?
  clawback_amount         Float?    @default(0)
  expected_turnover       Float?
  final_commission        Float     @default(0)
  kpi_activeness_score    Float?
  kpi_total_score         Float?
  kpi_unique_agents_score Float?
  kpi_value_score         Float?
  performance_ratio       Float?
  agents                  Agent     @relation(fields: [agent_id], references: [id])

  @@unique([agent_id, period])
  @@map("commissions")
}

model AgentAssignment {
  id           Int       @id @default(autoincrement())
  localAgentId Int       @map("local_agent_id")
  superAgentId Int?      @map("super_agent_id")
  franchiseId  Int?      @map("franchise_id")
  status       String    @default("active")
  assignedBy   String    @default("admin") @map("assigned_by")
  assignedAt   DateTime? @default(now()) @map("assigned_at")
  updatedAt    DateTime? @default(now()) @map("updated_at")
  franchise    Agent?    @relation("Franchise", fields: [franchiseId], references: [id])
  localAgent   Agent     @relation("LocalAgent", fields: [localAgentId], references: [id])
  superAgent   Agent?    @relation("SuperAgent", fields: [superAgentId], references: [id])

  @@unique([localAgentId, superAgentId, franchiseId])
  @@index([status])
  @@map("agent_assignments")
}

model AgentSuspension {
  id                Int       @id @default(autoincrement())
  agentId           Int       @map("agent_id")
  suspendedByUserId Int       @map("suspended_by_user_id")
  reason            String
  status            String    @default("pending")
  createdAt         DateTime? @default(now()) @map("created_at")
  approvedAt        DateTime? @map("approved_at")
  approvedByUserId  Int?      @map("approved_by_user_id")
  agent             Agent     @relation(fields: [agentId], references: [id])
  approvedBy        User?     @relation("approved_by", fields: [approvedByUserId], references: [id])
  suspendedBy       User      @relation("suspended_by", fields: [suspendedByUserId], references: [id])

  @@map("agent_suspensions")
}

model CommissionUserAssignment {
  id                 Int              @id @default(autoincrement())
  commissionConfigId Int              @map("commission_config_id")
  userId             Int              @map("user_id")
  createdAt          DateTime?        @default(now()) @map("created_at")
  updatedAt          DateTime?        @default(now()) @map("updated_at")
  commissionConfig   CommissionConfig @relation(fields: [commissionConfigId], references: [id])
  user               User             @relation(fields: [userId], references: [id])

  @@map("commission_user_assignments")
}

model UserLoginSession {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  sessionId    String    @map("session_id")
  ipAddress    String    @map("ip_address")
  userAgent    String?   @map("user_agent")
  location     String?
  browser      String?
  os           String?
  deviceType   String?   @map("device_type")
  deviceName   String?   @map("device_name")
  isActive     Int?      @default(1) @map("is_active")
  lastActivity DateTime? @default(now()) @map("last_activity")
  createdAt    DateTime? @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id])

  @@map("user_login_sessions")
}

model UserNotification {
  id        Int                @id @default(autoincrement())
  userId    Int?               @map("user_id")
  eventId   Int?               @map("event_id")
  title     String
  message   String
  isRead    Int?               @default(0) @map("is_read")
  actionUrl String?            @map("action_url")
  createdAt DateTime?          @default(now()) @map("created_at")
  expiresAt DateTime?          @map("expires_at")
  event     NotificationEvent? @relation("NotificationToUser", fields: [eventId], references: [id])
  user      User?              @relation(fields: [userId], references: [id])

  @@map("user_notifications")
}

model RegionalManagerAssignment {
  id                Int       @id @default(autoincrement())
  regionalManagerId Int       @map("regional_manager_id")
  agentId           Int       @map("agent_id")
  status            String    @default("active")
  assignedBy        String    @default("admin") @map("assigned_by")
  assignedAt        DateTime? @default(now()) @map("assigned_at")
  updatedAt         DateTime? @default(now()) @map("updated_at")
  agent             Agent     @relation(fields: [agentId], references: [id])
  regionalManager   User      @relation(fields: [regionalManagerId], references: [id])

  @@index([status])
  @@map("regional_manager_assignments")
}

model FaqCategory {
  id         Int           @id @default(autoincrement())
  slug       String        @unique
  title      String
  icon       String
  subtitle   String
  orderIndex Int?          @default(0) @map("order_index")
  isActive   Int?          @default(1) @map("is_active")
  createdAt  DateTime?     @default(now()) @map("created_at")
  updatedAt  DateTime?     @default(now()) @map("updated_at")
  questions  FaqQuestion[]

  @@map("faq_categories")
}

model FaqQuestion {
  id         Int          @id @default(autoincrement())
  categoryId Int?         @map("category_id")
  slug       String       @unique
  question   String
  answer     String
  orderIndex Int?         @default(0) @map("order_index")
  isActive   Int?         @default(1) @map("is_active")
  createdAt  DateTime?    @default(now()) @map("created_at")
  updatedAt  DateTime?    @default(now()) @map("updated_at")
  category   FaqCategory? @relation(fields: [categoryId], references: [id])

  @@map("faq_questions")
}

model HelpCenterCategory {
  id            Int                     @id @default(autoincrement())
  slug          String                  @unique
  title         String
  icon          String
  avatarColor   String                  @map("avatar_color")
  orderIndex    Int?                    @default(0) @map("order_index")
  isActive      Int?                    @default(1) @map("is_active")
  createdAt     DateTime?               @default(now()) @map("created_at")
  updatedAt     DateTime?               @default(now()) @map("updated_at")
  subcategories HelpCenterSubcategory[]

  @@map("help_center_categories")
}

model HelpCenterSubcategory {
  id         Int                 @id @default(autoincrement())
  categoryId Int?                @map("category_id")
  slug       String              @unique
  title      String
  icon       String
  orderIndex Int?                @default(0) @map("order_index")
  isActive   Int?                @default(1) @map("is_active")
  createdAt  DateTime?           @default(now()) @map("created_at")
  updatedAt  DateTime?           @default(now()) @map("updated_at")
  articles   HelpCenterArticle[]
  category   HelpCenterCategory? @relation(fields: [categoryId], references: [id])

  @@map("help_center_subcategories")
}

model HelpCenterArticle {
  id            Int                    @id @default(autoincrement())
  subcategoryId Int?                   @map("subcategory_id")
  slug          String                 @unique
  title         String
  content       String
  orderIndex    Int?                   @default(0) @map("order_index")
  isActive      Int?                   @default(1) @map("is_active")
  createdAt     DateTime?              @default(now()) @map("created_at")
  updatedAt     DateTime?              @default(now()) @map("updated_at")
  subcategory   HelpCenterSubcategory? @relation(fields: [subcategoryId], references: [id])

  @@map("help_center_articles")
}

model PopularArticle {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  title      String
  img        String
  subtitle   String
  orderIndex Int?      @default(0) @map("order_index")
  isActive   Int?      @default(1) @map("is_active")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("popular_articles")
}

model KeepLearningArticle {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  title      String
  img        String
  subtitle   String
  orderIndex Int?      @default(0) @map("order_index")
  isActive   Int?      @default(1) @map("is_active")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("keep_learning_articles")
}

model GeneralSetting {
  id              Int       @id @default(autoincrement())
  settingKey      String    @unique @map("setting_key")
  settingValue    String?   @map("setting_value")
  settingType     String    @map("setting_type")
  category        String
  label           String
  description     String?
  isRequired      Int?      @default(0) @map("is_required")
  validationRules String?   @map("validation_rules")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @default(now()) @map("updated_at")

  @@map("general_settings")
}

model NotificationSetting {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  label         String
  description   String?
  emailEnabled  Int?      @default(1) @map("email_enabled")
  smsEnabled    Int?      @default(0) @map("sms_enabled")
  pushEnabled   Int?      @default(0) @map("push_enabled")
  emailTemplate String?   @map("email_template")
  smsTemplate   String?   @map("sms_template")
  isActive      Int?      @default(1) @map("is_active")
  createdAt     DateTime? @default(now()) @map("created_at")
  updatedAt     DateTime? @default(now()) @map("updated_at")

  @@map("notification_settings")
}

model NotificationEvent {
  id                Int                     @id @default(autoincrement())
  eventType         String                  @map("event_type")
  eventName         String                  @map("event_name")
  description       String?
  isActive          Int?                    @default(1) @map("is_active")
  createdAt         DateTime?               @default(now()) @map("created_at")
  updatedAt         DateTime?               @default(now()) @map("updated_at")
  logs              NotificationLog[]
  recipients        NotificationRecipient[]
  userNotifications UserNotification[]      @relation("NotificationToUser")

  @@map("notification_events")
}

model NotificationRecipient {
  id             Int                @id @default(autoincrement())
  eventId        Int?               @map("event_id")
  recipientType  String             @map("recipient_type")
  recipientValue String?            @map("recipient_value")
  createdAt      DateTime?          @default(now()) @map("created_at")
  event          NotificationEvent? @relation(fields: [eventId], references: [id])

  @@map("notification_recipients")
}

model NotificationLog {
  id            Int                @id @default(autoincrement())
  eventId       Int?               @map("event_id")
  eventType     String             @map("event_type")
  eventName     String             @map("event_name")
  message       String
  recipientId   Int?               @map("recipient_id")
  recipientType String?            @map("recipient_type")
  status        String?            @default("pending")
  createdAt     DateTime?          @default(now()) @map("created_at")
  sentAt        DateTime?          @map("sent_at")
  event         NotificationEvent? @relation(fields: [eventId], references: [id])

  @@map("notification_logs")
}

model CommissionSchedule {
  id              Int       @id @default(autoincrement())
  frequency       String    @map("frequency")
  dayOfMonth      Int?      @default(1) @map("day_of_month")
  calculationType String?   @default("all") @map("calculation_type")
  isActive        Int?      @default(1) @map("is_active")
  lastRun         DateTime? @map("last_run")
  nextRun         DateTime? @map("next_run")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @default(now()) @map("updated_at")

  @@map("commission_schedules")
}

model UploadedFile {
  id           String   @id
  originalName String   @map("original_name")
  filePath     String   @map("file_path")
  fileSize     Int      @map("file_size")
  uploadedAt   DateTime @map("uploaded_at")
  status       String

  @@map("uploaded_files")
}
